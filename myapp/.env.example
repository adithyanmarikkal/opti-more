# Backend URL used by the app to prefix all /api calls.
# Local dev: leave EMPTY — Vite proxy forwards /api/* to localhost:8000 automatically.
# Production (Vercel): set this to your Render backend URL in the Vercel dashboard.
VITE_BACKEND_URL=

# Production example:
# VITE_BACKEND_URL=https://opti-more.onrender.com
